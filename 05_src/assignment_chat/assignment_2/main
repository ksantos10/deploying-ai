import gradio as gr
import os
import requests
import random
from dotenv import load_dotenv
from langchain.tools import tool
import chromadb
from chromadb.utils.embedding_functions import OpenAIEmbeddingFunction
from openai import OpenAI

# Load secrets
load_dotenv('../05_src/.secrets')

#OpenAI and Chromdb
client = OpenAI()
vector_db_client_url = "http://localhost:8000"
chroma = chromadb.HttpClient(host=vector_db_client_url)

# Restricted topics
restricted_topics = ["cat", "cats", "dog", "dogs", "horoscope", "zodiac", "taylor swift"]

def contains_restricted_topic(text):
    """Check if the input text contains any restricted topics."""
    return any(topic in text.lower() for topic in restricted_topics)

# Service 1 - WeatherBot
def get_weather(location):
    """Fetch the weather data for a specified location."""
    if contains_restricted_topic(location):
        return "Sorry, this topic is restricted and cannot be processed."

    location = location.strip() if location.strip() else 'Toronto'
    access_key = os.getenv('WEATHER_API_KEY')  # Obtain the access key from the environment
    url = f"http://api.weatherstack.com/current?access_key={access_key}&query={location}&units=m"
    
    response = requests.get(url)
    data = response.json()
    
    if "success" in data and not data["success"]:
        return f"Error: {data['error']['info']}"

 #weather data gather
    location_name = data.get('location', {}).get('name', 'Unknown location')
    temperature = data.get('current', {}).get('temperature', 'N/A')
    weather_desc = data.get('current', {}).get('weather_descriptions', ["N/A"])[0]

    return f"In {location_name}, the weather is currently '{weather_desc}' with a temperature of {temperature}°C."

# Service 2 - Book Recommendation System
@tool
def recommend_books(query: str, n_results: int = 3) -> str:
    """Fetch book review data based on the query. Return formatted results."""
    # Assuming the collection is already populated
    collection = chroma.get_collection(name="top_50_books_english_literature")
    results = collection.query(query_texts=[query], n_results=n_results)
    
    if not results['documents']:
        return "No results found."

    recommendations = []
    for idx, custom_id in enumerate(results['ids'][0]):
        book_title = results['documents'][0][idx]
        recommendations.append(f"**Recommendation {idx + 1}:** {book_title}")
    
    return '\n'.join(recommendations)

# Service 3 - Job Trivia
def get_random_job_fact():
    jobs_url = "https://api.dataatwork.org/v1/jobs?limit=20"
    try:
        jobs_resp = requests.get(jobs_url, timeout=8)
        jobs_resp.raise_for_status()
        jobs = jobs_resp.json()
    except Exception:
        return "Sorry, I'm having trouble fetching job trivia right now."

    job = random.choice(jobs)
    job_title = job.get("title", "Unknown Job")
    return f"Did you know? The job '{job_title}' exists in the database!"

def job_trivia_service(message):
    """Service interface function with guardrails."""
    if contains_restricted_topic(message):
        return "Sorry, I can't answer questions about restricted topics."
    return get_random_job_fact()

# Gradio Interfaces
def create_gradio_interfaces():
    weather_iface = gr.Interface(fn=get_weather, inputs="text", outputs="text", title="WeatherBot")
    
    with gr.Blocks() as book_app:
        gr.Markdown("# Book Recommendation System")
        input_textbox = gr.Textbox(label="Enter a book query:")
        output_textbox = gr.Markdown(label="Recommendations")
        submit_button = gr.Button("Get Recommendations")
        submit_button.click(fn=recommend_books, inputs=input_textbox, outputs=output_textbox)

    job_chat = gr.ChatInterface(fn=job_trivia_service, title="Job Skills Trivia Service")

    return weather_iface, book_app, job_chat

if __name__ == "__main__":
    weather_iface, book_app, job_chat = create_gradio_interfaces()
    weather_iface.launch()
    book_app.launch()
    job_chat.launch()